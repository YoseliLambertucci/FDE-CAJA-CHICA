# Copiá este archivo como ".env" y completá los valores. NUNCA subas el ".env" a GitHub.

# Proveedor del modelo: anthropic | groq | ollama
#   anthropic -> Claude (de pago, es lo que conviene para la entrega final)
#   groq      -> gratis en la nube (para probar)
#   ollama    -> local en tu PC (para probar sin internet ni clave)
PROVEEDOR=

# Solo se completa la clave del proveedor elegido
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Opcional: forzar un modelo (si se deja vacío usa el predeterminado de cada proveedor)
MODELO=

# Precios en USD por millón de tokens (verificar en la página oficial del proveedor)
PRECIO_ENTRADA_USD_MTOK=0.10
PRECIO_SALIDA_USD_MTOK=0.50
